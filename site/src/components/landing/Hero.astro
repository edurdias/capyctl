---
// Generated at build time by scripts/gen-hero.mjs from the CLI's table code.
import table from '../../generated/hero-table.txt?raw';
import { HERO_COMMAND, heroSegments } from '../../data/hero.mjs';
import { href } from '../../../site.config.mjs';
const lines = heroSegments(table);
---
<section class="hero">
  <p class="brand">
    <img class="logo-dark" src={href('/brand/logo-dark.webp')} alt="CapyCTL" width="480" height="600" />
    <img class="logo-light" src={href('/brand/logo-light.webp')} alt="CapyCTL" width="480" height="600" />
  </p>
  <h1>Control what runs <span class="accent">next.</span></h1>
  <p class="lede">Run your models on your own machines. Deploy, park, wake and switch models on vLLM and SGLang, behind one OpenAI-compatible endpoint, even when they don't all fit at once.</p>
  <p class="actions"><a class="button" href={href('/docs/install/')}>Install</a><a class="button secondary" href={href('/docs/')}>Docs</a></p>
  <pre class="terminal" tabindex="0" aria-label="Example terminal output"><code><span class="prompt">$ </span>{HERO_COMMAND}
{lines.map((segs) => <>{segs.map((s) => s.parked ? <span class="state-parked">{s.text}</span> : s.text)}{'\n'}</>)}</code></pre>
</section>

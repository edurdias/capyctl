<section>
  <h2>How it works</h2>
  <figure class="flow">
    <div class="node">Your apps</div>
    <div class="edge" aria-hidden="true">↓</div>
    <div class="node"><code>:8443/v1</code> OpenAI API</div>
    <div class="edge" aria-hidden="true">↓</div>
    <div class="node strong">mllm server<small>router · scheduler · memory ledger</small></div>
    <div class="edge"><span aria-hidden="true">↓</span> gRPC over mutual TLS</div>
    <div class="hosts">
      <div class="node">gpu-box<small>coding-small · vLLM · ready</small><small>vision-small · SGLang · <span class="state-parked">parked</span></small></div>
      <div class="node">workstation<small>chat-large · vLLM · ready</small></div>
    </div>

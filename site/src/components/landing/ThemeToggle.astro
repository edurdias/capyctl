<button type="button" class="theme" aria-label="Switch between light and dark theme">◐</button>
<script is:inline>
  document.currentScript.previousElementSibling.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('starlight-theme', next); } catch {}
  });
</script>

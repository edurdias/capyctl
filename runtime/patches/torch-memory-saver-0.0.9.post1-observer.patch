+uint32_t TorchMemorySaver::snapshot(TmsSnapshotRecordV1* records, uint32_t capacity, uint32_t* count) {
+#if defined(USE_ROCM)
+    return TMS_SNAPSHOT_UNSUPPORTED;
+#else
+    std::unique_lock<std::mutex> lock(allocator_metadata_mutex_, std::try_to_lock);
+    if (!lock.owns_lock()) return TMS_SNAPSHOT_BUSY;
+    if (observation_invalid_) return TMS_SNAPSHOT_INVALID;
+    if (mutations_in_flight_ != 0) return TMS_SNAPSHOT_BUSY;
+    if (allocation_metadata_.size() > capacity) return TMS_SNAPSHOT_OVERFLOW;
+
+    // Validate the entire map before exposing any record to the caller.
+    for (const auto& item : allocation_metadata_) {
+        const auto address = reinterpret_cast<uintptr_t>(item.first);
+        const auto& metadata = item.second;
+        if (address == 0 || metadata.size == 0 ||
+            metadata.size > std::numeric_limits<uint64_t>::max() - address ||
+            metadata.device < 0 || metadata.tag.size() > 63 ||
+            metadata.tag.find('\0') != std::string::npos ||
+            (metadata.state != AllocationState::ACTIVE && metadata.state != AllocationState::PAUSED) ||
+            (!metadata.enable_cpu_backup && metadata.cpu_backup != nullptr) ||
+            (metadata.enable_cpu_backup && metadata.state == AllocationState::PAUSED && metadata.cpu_backup == nullptr)) {
+            return TMS_SNAPSHOT_INVALID;
+        }
+    }
+    uint32_t index = 0;
+    for (const auto& item : allocation_metadata_) {
+        const auto& metadata = item.second;
+        TmsSnapshotRecordV1 record{};
+        record.address = reinterpret_cast<uintptr_t>(item.first);
+        record.size_bytes = metadata.size;
+        record.backup_bytes = metadata.cpu_backup != nullptr ? metadata.size : 0;
+        record.device = metadata.device;
+        record.state = metadata.state == AllocationState::ACTIVE ? 1 : 2;
+        record.backup_enabled = metadata.enable_cpu_backup ? 1 : 0;
+        record.tag_length = static_cast<uint32_t>(metadata.tag.size());
+        std::memcpy(record.tag, metadata.tag.data(), metadata.tag.size());
+        records[index++] = record;
+    }
+    *count = index;
+    return TMS_SNAPSHOT_OK;
+#endif
+}

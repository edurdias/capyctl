+TorchMemorySaver::MutationGuard::MutationGuard(TorchMemorySaver& saver)
+    : saver_(saver), exceptions_(std::uncaught_exceptions()) {
+    try {
+        const std::lock_guard<std::mutex> lock(saver_.allocator_metadata_mutex_);
+        if (saver_.mutations_in_flight_ == std::numeric_limits<uint64_t>::max()) {
+            saver_.observation_invalid_ = true;
+        } else {
+            ++saver_.mutations_in_flight_;
+            counted_ = true;
+        }
+    } catch (...) {
+        saver_.observation_invalid_ = true;
+        throw;
+    }
+}
+
+TorchMemorySaver::MutationGuard::~MutationGuard() noexcept {
+    try {
+        const std::lock_guard<std::mutex> lock(saver_.allocator_metadata_mutex_);
+        if (std::uncaught_exceptions() > exceptions_) saver_.observation_invalid_ = true;
+        if (counted_) {
+            if (saver_.mutations_in_flight_ == 0) saver_.observation_invalid_ = true;
+            else --saver_.mutations_in_flight_;
+        }
+    } catch (...) {
+        // A failed bookkeeping lock must not make later snapshots look complete.
+        saver_.observation_invalid_ = true;
+    }
+}
+
 TorchMemorySaver::TorchMemorySaver() {}


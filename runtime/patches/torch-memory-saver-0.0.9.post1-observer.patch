+extern "C" uint32_t tms_snapshot_v1(
+    uint32_t abi_version, uint32_t record_size,
+    TmsSnapshotRecordV1* records, uint32_t capacity, uint32_t* count) noexcept {
+    if (count == nullptr) return TMS_SNAPSHOT_INVALID;
+    *count = 0;
+    if (abi_version != 1 || record_size != sizeof(TmsSnapshotRecordV1) ||
+        records == nullptr || capacity == 0 || capacity > 4096) {
+        return TMS_SNAPSHOT_INVALID;
+    }
+    try {
+        return TorchMemorySaver::instance().snapshot(records, capacity, count);
+    } catch (...) {
+        *count = 0;
+        return TMS_SNAPSHOT_INTERNAL;
+    }
+}

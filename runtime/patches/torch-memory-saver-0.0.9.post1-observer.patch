+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+
+// Read-only CUDA allocation-map ABI; addresses are private to this process.
+enum TmsSnapshotStatus : uint32_t {
+    TMS_SNAPSHOT_OK = 0, TMS_SNAPSHOT_BUSY = 1,
+    TMS_SNAPSHOT_INVALID = 2, TMS_SNAPSHOT_OVERFLOW = 3,
+    TMS_SNAPSHOT_UNSUPPORTED = 4, TMS_SNAPSHOT_INTERNAL = 5
+};
+struct TmsSnapshotRecordV1 {
+    uint64_t address;
+    uint64_t size_bytes;
+    uint64_t backup_bytes;
+    int32_t device;
+    uint32_t state;
+    uint32_t backup_enabled;
+    uint32_t tag_length;
+    char tag[64];
+};
+static_assert(sizeof(void*) == 8, "snapshot ABI requires 64-bit pointers");
+static_assert(std::is_standard_layout<TmsSnapshotRecordV1>::value);
+static_assert(sizeof(TmsSnapshotRecordV1) == 104);
+static_assert(offsetof(TmsSnapshotRecordV1, address) == 0);
+static_assert(offsetof(TmsSnapshotRecordV1, size_bytes) == 8);
+static_assert(offsetof(TmsSnapshotRecordV1, backup_bytes) == 16);
+static_assert(offsetof(TmsSnapshotRecordV1, device) == 24);
+static_assert(offsetof(TmsSnapshotRecordV1, state) == 28);
+static_assert(offsetof(TmsSnapshotRecordV1, backup_enabled) == 32);
+static_assert(offsetof(TmsSnapshotRecordV1, tag_length) == 36);
+static_assert(offsetof(TmsSnapshotRecordV1, tag) == 40);
+
+extern "C" uint32_t tms_snapshot_v1(
+    uint32_t abi_version, uint32_t record_size,
+    TmsSnapshotRecordV1* records, uint32_t capacity, uint32_t* count) noexcept;

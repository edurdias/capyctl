# mllm host agent, as a system service (SPEC §4.3: foreground role, OS
# service definition, no custom daemonization).
#
# Install: docs/operations/install.md. Customize with a drop-in
# (`systemctl edit mllm-host`), never by editing this file in place.
#
# Stopping or restarting this unit is a SERVICE RESTART, not a drain.
# SIGTERM closes admission, lets admitted requests finish within the host
# document's `shutdown.drain_timeout`, and exits without touching an engine.
# The engines stay running in their own process groups and the next start
# re-attaches them (crates/mllm-cli/src/shutdown.rs, owner decision P3). To
# stop the engines on this host, drain it explicitly BEFORE stopping the unit:
#
#     mllm drain host <name> --config /etc/mllm/server.yaml   (on the server)
#
# There is deliberately no ExecStop= that drains: a package upgrade or a
# `systemctl restart` must never stop deployments as a side effect.

[Unit]
Description=mllm host agent
Documentation=file:///usr/local/share/mllm/docs/operations/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mllm
Group=mllm
# Optional overrides (MLLM_CONFIG, RUST_LOG, ...). The leading '-' makes the
# file optional.
Environment=MLLM_CONFIG=/etc/mllm/host.yaml
EnvironmentFile=-/etc/mllm/host.env
ExecStart=/usr/local/bin/mllm start host --config ${MLLM_CONFIG}

# SPEC §4.3: engines must SURVIVE a restart of this unit. systemd's default
# (control-group) and `mixed` both signal every process in the cgroup, which
# would kill the engines the host launched. `process` signals the main mllm
# process only; the engines, launched into their own process groups, keep
# serving and are re-attached by the next start. They remain in this unit's
# cgroup, which is why the resource limits below apply to them too.
KillMode=process
KillSignal=SIGTERM
# Must cover the drain: `shutdown.drain_timeout` (default 30s, at most 600s)
# plus the 2s cancellation grace and teardown. Keep it at least
# drain_timeout + 60s; raise it in a drop-in when the host document raises
# drain_timeout. Only the mllm process is killed if it expires.
TimeoutStopSec=90s
TimeoutStartSec=90s

Restart=on-failure
RestartSec=5s
# Invalid configuration (2), unauthorized identity (3), unsupported requests
# (5) and a host the controller revoked (14) do not heal by restarting.
# SPEC §4.1, ADR 0016: on 14 the agent has stopped reconnecting; KillMode=process
# leaves its engines running for `mllm join host --recover` to re-prove.
RestartPreventExitStatus=2 3 5 14
# An engine the kernel OOM-kills is the host's to reconcile; it must not stop
# the agent (the default OOMPolicy stops the whole unit).
OOMPolicy=continue

# Engines inherit these limits (they run in this cgroup).
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity

# mllm's private state is owner-only (SPEC §13.3).
UMask=0077
# The state root, owned by the service user. The host document's state_dir
# (for example /var/lib/mllm/host) lives beneath it; mllm creates it 0700.
# /var/lib/mllm must be a real directory, not a symlink: the observation and
# identity directories are refused unless their path is canonical.
StateDirectory=mllm mllm/tmp
StateDirectoryMode=0700
# Engines' temporary files (torch/triton compilation, sockets) go to a private
# directory instead of the shared /tmp.
Environment=TMPDIR=/var/lib/mllm/tmp

# Hardening. Engines are children of this process and share its sandbox, so
# anything that would break a GPU engine is deliberately absent:
#   - no PrivateDevices=, DeviceAllow=, ProtectClock= (the last two imply a
#     device allow-list), which would hide /dev/nvidia*;
#   - no MemoryDenyWriteExecute= or SystemCallFilter= (Python, CUDA and JIT
#     compilers need both);
#   - no PrivateTmp=: with KillMode=process the engines outlive a stop, and
#     systemd deletes a unit's private /tmp when it stops, underneath running
#     engines; a restarted host would also see a different /tmp than the
#     engines it re-attaches. TMPDIR above keeps temporary files private
#     instead, and /tmp stays writable for engine code that hard-codes it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/tmp /var/tmp
# Engine installations may live under /home; they are read, never written.
ProtectHome=read-only
# The model store is read-only by default (mllm never downloads weights,
# SPEC §15.2). Add it here in a drop-in only if engines must write into it:
#ReadWritePaths=/srv/models
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

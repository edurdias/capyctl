# capyctl standalone role (embedded server and host), as a system service
# (SPEC §4.3: foreground role, OS service definition, no custom
# daemonization).
#
# Install: docs/operations/install.md. Customize with a drop-in
# (`systemctl edit capyctl-standalone`), never by editing this file in place.
#
# Stopping or restarting this unit is a SERVICE RESTART, not a drain.
# SIGTERM closes admission, lets admitted requests finish within
# `shutdown.drain_timeout` of <state_dir>/config/standalone.yaml, and exits
# without touching an engine.
# The engines stay running in their own process groups and the next start
# re-attaches them (crates/capyctl-cli/src/shutdown.rs, decided 2026-09-22). To
# stop the engines, drain explicitly BEFORE stopping the unit, as the service
# user and with the same state directory:
#
#     sudo -u capyctl env CAPYCTL_STATE_DIR=/var/lib/capyctl/standalone capyctl drain standalone
#
# There is deliberately no ExecStop= that drains: a package upgrade or a
# `systemctl restart` must never stop deployments as a side effect.

[Unit]
Description=capyctl standalone (server and embedded host)
Documentation=file:///usr/local/share/capyctl/docs/operations/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=capyctl
Group=capyctl
# Without --config (or CAPYCTL_CONFIG, which names the document the same way, as
# for `capyctl engine`) the role document is <CAPYCTL_STATE_DIR>/config/standalone.yaml,
# generated there on first start, so reinstalling this unit on upgrade never
# depends on a file the operator has not written. To use an explicit document,
# override ExecStart= in a drop-in (docs/operations/install.md, "Explicit
# standalone document"):
#   ExecStart=
#   ExecStart=/usr/local/bin/capyctl start standalone --config <file>
# A missing or invalid explicit file then fails the start (exit 2, not
# restarted); it is never replaced by defaults (SPEC §15.2, R13).
# The engine installation (CAPYCTL_VLLM_BIN or CAPYCTL_SGLANG_BIN, ...) belongs in
# the environment file, as do the optional CAPYCTL_MODELS_ROOT (default ~/models)
# and CAPYCTL_MODEL_SOURCES; the role document's host.local_engine names it too
# (docs/operations/configuration.md). The leading '-' makes the file optional.
Environment=CAPYCTL_STATE_DIR=/var/lib/capyctl/standalone
# capyctl's runtime helpers are compiled into the binary and written to
# /var/lib/capyctl/standalone/runtime (owner-only) at every start; CAPYCTL_RUNTIME_DIR, for
# development, names another directory instead.
EnvironmentFile=-/etc/capyctl/standalone.env
ExecStart=/usr/local/bin/capyctl start standalone

# SPEC §4.3: engines must SURVIVE a restart of this unit. systemd's default
# (control-group) and `mixed` both signal every process in the cgroup, which
# would kill the engines the embedded host launched. `process` signals the main capyctl
# process only; the engines, launched into their own process groups, keep
# serving and are re-attached by the next start. They remain in this unit's
# cgroup, which is why the resource limits below apply to them too.
KillMode=process
KillSignal=SIGTERM
# Must cover the drain: `shutdown.drain_timeout` (default 30s, at most 600s)
# plus the 2s cancellation grace and teardown. Keep it at least
# drain_timeout + 60s; raise it in a drop-in when standalone.yaml raises
# drain_timeout. Only the capyctl process is killed if it expires.
TimeoutStopSec=90s
TimeoutStartSec=90s

Restart=on-failure
RestartSec=5s
# Invalid configuration (2), unauthorized/revoked identity (3) and unsupported
# requests (5, including state written by a newer capyctl) do not heal by
# restarting.
RestartPreventExitStatus=2 3 5
# An engine the kernel OOM-kills is the embedded host's to reconcile; it must
# not stop the role (the default OOMPolicy stops the whole unit).
OOMPolicy=continue

# Engines inherit these limits (they run in this cgroup).
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity

# capyctl's private state is owner-only (SPEC §13.3).
UMask=0077
# The state root, owned by the service user. CAPYCTL_STATE_DIR
# (/var/lib/capyctl/standalone) lives beneath it; capyctl creates it 0700.
# /var/lib/capyctl must be a real directory, not a symlink: the observation and
# identity directories are refused unless their path is canonical.
StateDirectory=capyctl capyctl/tmp
StateDirectoryMode=0700
# Engines' temporary files (torch/triton compilation, sockets) go to a private
# directory instead of the shared /tmp.
Environment=TMPDIR=/var/lib/capyctl/tmp

# Hardening. Engines are children of this process and share its sandbox, so
# anything that would break a GPU engine is deliberately absent:
#   - no PrivateDevices=, DeviceAllow=, ProtectClock= (the last two imply a
#     device allow-list), which would hide /dev/nvidia*;
#   - no MemoryDenyWriteExecute= or SystemCallFilter= (Python, CUDA and JIT
#     compilers need both);
#   - no PrivateTmp=: with KillMode=process the engines outlive a stop, and
#     systemd deletes a unit's private /tmp when it stops, underneath running
#     engines; a restarted role would also see a different /tmp than the
#     engines it re-attaches. TMPDIR above keeps temporary files private
#     instead, and /tmp stays writable for engine code that hard-codes it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/tmp /var/tmp
# Engine installations may live under /home; they are read, never written.
ProtectHome=read-only
# The model store is read-only by default (capyctl never downloads weights,
# SPEC §15.2). Add it here in a drop-in only if engines must write into it:
#ReadWritePaths=/srv/models
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

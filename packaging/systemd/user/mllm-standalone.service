# mllm standalone role (embedded server and host), as a user service
# (SPEC §4.3: foreground role, OS service definition, no custom
# daemonization).
#
# Install: docs/operations/install.md. Customize with a drop-in
# (`systemctl --user edit mllm-standalone`), never by editing this file in place.
# Keep the user manager running while logged out: `loginctl enable-linger`;
# otherwise logging out stops the role.
#
# Stopping or restarting this unit is a SERVICE RESTART, not a drain.
# SIGTERM closes admission, lets admitted requests finish within
# `shutdown.drain_timeout` of <state_dir>/config/standalone.yaml, and exits
# without touching an engine.
# The engines stay running in their own process groups and the next start
# re-attaches them (crates/mllm-cli/src/shutdown.rs, owner decision P3). To
# stop the engines, drain explicitly BEFORE stopping the unit, as the service
# user and with the same state directory:
#
#     mllm drain standalone
#
# There is deliberately no ExecStop= that drains: a package upgrade or a
# `systemctl restart` must never stop deployments as a side effect.

[Unit]
Description=mllm standalone (server and embedded host)
Documentation=file://%h/.local/share/mllm/docs/operations/install.md

[Service]
Type=simple
# Without --config (or MLLM_CONFIG, which names the document the same way, as
# for `mllm engine`) the role document is <MLLM_STATE_DIR>/config/standalone.yaml,
# generated there on first start, so reinstalling this unit on upgrade never
# depends on a file the operator has not written. To use an explicit document,
# override ExecStart= in a drop-in (docs/operations/install.md, "Explicit
# standalone document"):
#   ExecStart=
#   ExecStart=%h/.local/bin/mllm start standalone --config <file>
# A missing or invalid explicit file then fails the start (exit 2, not
# restarted); it is never replaced by defaults (SPEC §15.2, R13).
# The engine installation always comes from the environment (MLLM_VLLM_BIN or
# MLLM_SGLANG_BIN, MLLM_MODELS_ROOT, ...), which belongs in the environment
# file. The leading '-' makes the file optional.
# MLLM_STATE_DIR is left unset: the role then uses ~/.local/state/mllm,
# which is what `mllm drain standalone` run by the same user reads too.
# mllm's runtime helpers are compiled into the binary and written to
# ~/.local/state/mllm/runtime (owner-only) at every start; MLLM_RUNTIME_DIR, for
# development, names another directory instead.
EnvironmentFile=-%E/mllm/standalone.env
ExecStart=%h/.local/bin/mllm start standalone

# SPEC §4.3: engines must SURVIVE a restart of this unit. systemd's default
# (control-group) and `mixed` both signal every process in the cgroup, which
# would kill the engines the embedded host launched. `process` signals the main mllm
# process only; the engines, launched into their own process groups, keep
# serving and are re-attached by the next start. They remain in this unit's
# cgroup, which is why the resource limits below apply to them too.
KillMode=process
KillSignal=SIGTERM
# Must cover the drain: `shutdown.drain_timeout` (default 30s, at most 600s)
# plus the 2s cancellation grace and teardown. Keep it at least
# drain_timeout + 60s; raise it in a drop-in when standalone.yaml raises
# drain_timeout. Only the mllm process is killed if it expires.
TimeoutStopSec=90s
TimeoutStartSec=90s

Restart=on-failure
RestartSec=5s
# Invalid configuration (2), unauthorized/revoked identity (3) and unsupported
# requests (5, including state written by a newer mllm) do not heal by
# restarting.
RestartPreventExitStatus=2 3 5
# An engine the kernel OOM-kills is the embedded host's to reconcile; it must
# not stop the role (the default OOMPolicy stops the whole unit).
OOMPolicy=continue

# Engines inherit these limits (they run in this cgroup).
# The user manager cannot raise the hard limit; keep within it.
LimitNOFILE=65536:524288
TasksMax=infinity

# mllm's private state is owner-only (SPEC §13.3).
UMask=0077
# The state root, ~/.local/state/mllm (%S/mllm). Role state_dir values live
# beneath it; it must be a real directory, not a symlink.
StateDirectory=mllm mllm/tmp
StateDirectoryMode=0700
# Engines' temporary files (torch/triton compilation, sockets) go to a private
# directory instead of the shared /tmp.
Environment=TMPDIR=%S/mllm/tmp

# User units get no file-system sandboxing: ProtectSystem= and friends need
# privileges the per-user manager does not have (systemd.exec(5)). The service
# runs with the invoking user's own rights; the system unit is the hardened
# form.
NoNewPrivileges=yes

[Install]
WantedBy=default.target

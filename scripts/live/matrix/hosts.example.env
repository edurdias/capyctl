# Machines for the live matrix harness. Copy this file to hosts.local.env in the
# same directory (gitignored) and set every value for your lab. lib.sh sources
# hosts.local.env and refuses to run when it is missing or incomplete;
# CAPYCTL_MATRIX_HOSTS_ENV points the harness at a different file.
#
# The harness reaches both hosts over SSH by these names (an ssh config alias
# or a resolvable host name), and each name is also the host's enrolled name.

# The two managed hosts. Fixture tags use a for HOST_A and b for HOST_B
# (va-4 is vLLM q4 on HOST_A, sb-14 is SGLang q14 on HOST_B).
HOST_A=host-a
HOST_B=host-b
# The control-plane machine that runs the server and the harness.
CONTROL_HOST=control-host

# Private addresses (for example Tailscale 100.64/10). Each host's ingress binds
# its address; the server listens on CONTROL_HOST_ADDR.
HOST_A_ADDR=100.64.0.10
HOST_B_ADDR=100.64.0.11
CONTROL_HOST_ADDR=100.64.0.20

# A direct link between the two hosts (multi-node groups, rows MN1-MN8, ADR 0028).
# roles.sh host-doc declares each address as that host's group peer address
# (resource_policy.groups.peer_address) with GROUP_RENDEZVOUS_PORTS (default
# 25000-25099) as its rendezvous range; CAPYCTL_GROUPS=0 leaves the block out.
HOST_A_DIRECT_ADDR=192.0.2.10
HOST_B_DIRECT_ADDR=192.0.2.11

# Home directory of the SSH user on both hosts. CAPYCTL_REMOTE_HOME overrides it.
REMOTE_HOME=/home/user
# Engine environments, relative to REMOTE_HOME. Use only environments the
# owner has authorized; the harness never creates or modifies one.
SGLANG_VENV_DIR=capyctl-sglang-0.5.20-venv
HOST_A_VLLM_VENV_DIR=capyctl-vllm-venv
HOST_B_VLLM_VENV_DIR=capyctl-vllm-venv
# Optional: TensorFold, the same directory name on both hosts; roles.sh adds a
# `tensorfold` profile when it is set (MN3, and MN5/MN6 with tensorfold).
TENSORFOLD_VENV_DIR=capyctl-tensorfold-venv
# Group bring-up checkpoints (design section 17.2): directories under
# REMOTE_HOME/models, the same contents on both hosts. Qwen3-30B-A3B for vLLM and
# SGLang; Nemotron 3.5 Lightning 30B-A3B MLX 4-bit for TensorFold.
GROUP_MODEL_VLLM_SGLANG=qwen3-30b-a3b
GROUP_MODEL_TENSORFOLD=nemotron-3.5-lightning-30b-a3b-4bit-tf

# Optional: the run server's loopback management and inference ports (default
# 7443 and 8443), for a control host where another server already holds them.
# CAPYCTL_SERVER_MGMT_PORT=7543
# CAPYCTL_SERVER_INFER_PORT=8543

# The OpenTelemetry rows (OT1-OT11, ADR 0037). The OpenTelemetry Collector release
# binary the owner placed in the home directory on host A and host B (owner
# decision 2026-10-27, question 11), relative to REMOTE_HOME; optionally its
# release SHA-256, checked before each start; the loopback port of its OTLP/HTTP
# receiver (default 4318) and, for OT6, the control host's loopback port that an
# SSH forward carries to it (default 14318).
OTELCOL_BIN=otelcol-0.164.0/otelcol
# OTELCOL_SHA256=<sha256 of the release's otelcol binary>
# OTELCOL_PORT=4318
# OT_TUNNEL_PORT=14318
# The approved environments, relative to REMOTE_HOME: vLLM 0.32.0, SGLang 0.5.22
# and llama.cpp v0.7.0 (scripts/live/llamacpp-build.sh with LLAMACPP_TAG=v0.7.0).
OT_VLLM_VENV_DIR=vllm-0.32.0-venv
OT_SGLANG_VENV_DIR=sglang-0.5.22-venv
OT_LLAMACPP_DIR=llamacpp-v0.7.0
# Models under REMOTE_HOME/models: Qwen3-4B for chat, its Q4_K_M GGUF for
# llama.cpp, Clef-Flash for decisions on SGLang.
OT_CHAT_MODEL=qwen3-4b-instruct
OT_GGUF_MODEL=Qwen3-4B-GGUF
OT_DECISION_MODEL=clef-flash
# Optional (OT10): an owner-authorized engine environment without the
# OpenTelemetry packages, relative to REMOTE_HOME, and its engine (vllm or
# sglang), used when both approved environments hold them.
# OT_NOSDK_ENV=sglang-0.5.22-notrace-venv
# OT_NOSDK_ENGINE=sglang

# The discrete-GPU rows (discrete_gpu.sh, DG1-DG7) run on that machine itself.
# Its name, for the record; the engine environments in its home directory; two
# instruct models under its models directory (A the larger, B the smaller).
DGPU_HOST=dgpu-laptop
DGPU_VLLM_VENV=/home/user/capyctl-vllm-venv
DGPU_SGLANG_VENV=/home/user/capyctl-sglang-venv
DGPU_MODEL_A=qwen3-4b-instruct
DGPU_MODEL_B=qwen2.5-1.5b-instruct
# Optional: the machine's own tailnet or LAN address (DG6) and a previous
# release binary to upgrade from (DG6 migration).
DGPU_LISTEN_ADDR=100.64.0.30
DGPU_PREVIOUS_BIN=/home/user/capyctl-previous/bin/capyctl
